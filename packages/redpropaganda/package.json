{
    "name": "koishi-plugin-redpropaganda",
    "version": "1.2.0",
    "contributors": [
        "Oppenheymu <oppenheymu@gmail.com>"
    ],
    "main": "lib/index.cjs",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "development": "./src/index.ts",
            "default": "./lib/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "locales",
        "assets"
    ],
    "license": "MIT",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://github.com/Oppenheymu/koishi-plugin-socialism/tree/main/packages/redpropaganda",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Oppenheymu/koishi-plugin-socialism.git",
        "directory": "packages/redpropaganda"
    },
    "keywords": [
        "chatbot",
        "koishi",
        "plugin",
        "propaganda",
        "slogan"
    ],
    "scripts": {
        "build": "pnpm --dir ../.. exec tsdown -W -F koishi-plugin-redpropaganda"
    },
    "peerDependencies": {
        "koishi": "^4.17.5",
        "koishi-plugin-cron-fix": "^0.1.0"
    },
    "devDependencies": {
        "koishi-plugin-redarchive": "workspace:*",
        "koishi-plugin-redmusic": "workspace:*",
        "koishi-plugin-redposter": "workspace:*",
        "koishi-plugin-redquote": "workspace:*"
    },
    "koishi": {
        "description": {
            "es": "Transmisión programada de propaganda roja a través de plugins rojos",
            "fr": "Diffusion programmée de propagande rouge via les plugins rouges",
            "ja": "赤系プラグインによる定期的なプロパガンダ配信",
            "de": "Geplante rote Propaganda-Ausstrahlung über rote Plugins",
            "ru": "Запланированная трансляция красной пропаганды через красные плагины",
            "en": "Scheduled propaganda broadcast via red plugins",
            "zh": "定时向群内推送红色宣传内容（语录/文库/歌曲/海报）"
        },
        "service": {
            "required": [
                "cron"
            ],
            "optional": [
                "redquote",
                "redarchive",
                "redmusic",
                "redposter"
            ]
        }
    }
}