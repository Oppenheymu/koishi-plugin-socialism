{
    "name": "koishi-plugin-redpropaganda",
    "version": "1.1.2",
    "contributors": [
        "Oppenheymu <oppenheymu@gmail.com>"
    ],
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "development": "./src/index.ts",
            "default": "./lib/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "assets"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://github.com/Oppenheymu/koishi-plugin-socialism/tree/main/packages/redpropaganda",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Oppenheymu/koishi-plugin-socialism.git",
        "directory": "packages/redpropaganda"
    },
    "keywords": [
        "chatbot",
        "koishi",
        "plugin",
        "propaganda",
        "slogan"
    ],
    "scripts": {
        "build": "tsc -b"
    },
    "peerDependencies": {
        "koishi": "^4.17.5",
        "koishi-plugin-cron-fix": "^0.1.0"
    },
    "devDependencies": {
        "koishi-plugin-redarchive": "workspace:*",
        "koishi-plugin-redmusic": "workspace:*",
        "koishi-plugin-redposter": "workspace:*",
        "koishi-plugin-redquote": "workspace:*"
    },
    "koishi": {
        "description": {
            "en": "Scheduled propaganda broadcast via red plugins",
            "zh": "定时向群内推送红色宣传内容（语录/文库/歌曲/海报）"
        },
        "service": {
            "required": [
                "cron"
            ],
            "optional": [
                "redquote",
                "redarchive",
                "redmusic",
                "redposter"
            ]
        }
    }
