{
    "name": "koishi-plugin-redarchive",
    "version": "3.3.1",
    "contributors": [
        "Oppenheymu <oppenheymu@gmail.com>"
    ],
    "main": "lib/index.cjs",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "development": "./src/index.ts",
            "default": "./lib/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "locales"
    ],
    "license": "MIT",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://github.com/Oppenheymu/koishi-plugin-socialism/tree/main/packages/redarchive",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Oppenheymu/koishi-plugin-socialism.git",
        "directory": "packages/redarchive"
    },
    "keywords": [
        "chatbot",
        "koishi",
        "plugin",
        "marxists",
        "archive"
    ],
    "scripts": {
        "build": "pnpm --dir ../.. exec tsdown -W -F koishi-plugin-redarchive"
    },
    "peerDependencies": {
        "koishi": "^4.17.5"
    },
    "dependencies": {
        "cheerio": "^1.0.0",
        "domhandler": "^5.0.3",
        "iconv-lite": "^0.6.3"
    },
    "koishi": {
        "descrs": "Descarga archivos de la Biblioteca Marxista China",
        "fr": "Télécharge des fichiers de la bibliothèque marxiste chinoise",
        "ja": "中国マルクス主義文庫からファイルをダウンロードする",
        "de": "Lädt Dateien aus der chinesischen marxistischen Bibliothek herunter",
        "ru": "Скачивает файлы из китайской марксистской библиотеки",
        "eiption": {
            "en": "Download files from the Chinese Marxist Library",
            "zh": "爬取中文马克思主义文库文件，注入 ctx.redarchive 供其它插件使用"
        },
        "service": {
            "implements": [
                "redarchive"
            ]
        }
    }
}